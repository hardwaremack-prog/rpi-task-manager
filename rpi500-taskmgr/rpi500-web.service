[Unit]
Description=RPi500+ Task Manager web page (for phones and PCs on the same network)
After=network.target

[Service]
User=@USER@
Environment=RZ_PORT=8090
Environment=RZ_LOG_DIR=@DESKTOP@
ExecStart=/usr/bin/python3 /opt/rpi500-taskmgr/rpi500_web.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
